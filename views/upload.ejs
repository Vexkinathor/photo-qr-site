<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ajouter une photo</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="wrap">
    <header class="topbar">
      <h1>Ajouter une photo</h1>
      <a href="/gallery" class="btn">&larr; Retour a la galerie</a>
    </header>

    <div class="card" style="max-width: 480px;">
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
      <form method="POST" action="/upload" enctype="multipart/form-data">
        <div>
          <label for="name">Nom de la photo</label><br />
          <input type="text" id="name" name="name" placeholder="Ex: Anniversaire de Julie" />
        </div>
        <div>
          <label for="photo">Fichier image</label><br />
          <input type="file" id="photo" name="photo" accept="image/*" required />
        </div>
        <div>
          <label for="maxViews">Nombre maximum d'ouvertures avant suppression automatique</label><br />
          <input type="number" id="maxViews" name="maxViews" min="1" placeholder="Laisser vide = illimite" />
        </div>
        <button type="submit" class="btn primary">Ajouter et generer le QR code</button>
      </form>
    </div>
  </div>
</body>
</html>
