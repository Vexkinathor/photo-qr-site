# Port sur lequel le site va tourner
PORT=3000

# Mot de passe pour acceder a l'espace admin (upload / galerie)
ADMIN_PASSWORD=change-moi

# Chaine aleatoire secrete pour securiser les sessions (mettez n'importe quoi de long et aleatoire)
SESSION_SECRET=change-moi-aussi-avec-une-longue-chaine-aleatoire

# URL publique de votre site une fois deploye (utilisee pour generer les QR codes)
# En local : http://localhost:3000
# En production, exemple : https://mesphotos.mondomaine.com
BASE_URL=http://localhost:3000
